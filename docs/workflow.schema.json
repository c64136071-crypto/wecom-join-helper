{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restricted fixture workflow v1",
  "description": "Shape schema. Runtime additionally checks unique step ids, forward-only references, adapter-specific capabilities, lexical integer types, finite numbers, integer literal magnitude <= 10^12 and <=65536 normalized JSON bytes. No GUI adapter is provided.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "timeout_ms", "steps"],
  "properties": {
    "version": {"const": 1, "type": "integer"},
    "runId": {"$ref": "#/$defs/identifier"},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
    "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "identifier": {"type":"string", "pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "scalar": {"oneOf": [
      {"type":"null"}, {"type":"boolean"}, {"type":"number"}, {"type":"string","maxLength":4096}
    ]},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "target", "value", "timeout_ms"],
      "properties": {
        "id": {"$ref":"#/$defs/identifier"},
        "action": {"enum":["locate","read","click","input","wait","assert"]},
        "target": {"enum":[null,"name","quantity","save","receipt","period","export","total"]},
        "value": {"$ref":"#/$defs/scalar"},
        "timeout_ms": {"type":"integer","minimum":1,"maximum":10000},
        "next": {"$ref":"#/$defs/identifier"},
        "on_false": {"$ref":"#/$defs/identifier"}
      },
      "allOf": [
        {"if":{"properties":{"action":{"const":"wait"}}},
         "then":{"properties":{"target":{"type":"null"},"value":{"type":"integer","minimum":0,"maximum":10000}}},
         "else":{"properties":{"target":{"type":"string"}}}},
        {"if":{"properties":{"action":{"enum":["locate","read","click"]}}},
         "then":{"properties":{"value":{"type":"null"}}}},
        {"if":{"required":["on_false"]},"then":{"properties":{"action":{"const":"assert"}}}}
      ]
    }
  }
}
